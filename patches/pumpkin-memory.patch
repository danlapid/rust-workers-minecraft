+/// In-memory palette indices use 1, 2, 4, or 8 bits per block. Wire-format
+/// packing remains independent because Minecraft pads entries within each u64.
+#[derive(Clone)]
+struct PackedIndices {
+    bytes: Box<[u8]>,
+    len: usize,
+    bits: u8,
+}
+
+impl PackedIndices {
+    fn width(palette_len: usize) -> u8 {
+        match palette_len {
+            0..=2 => 1,
+            3..=4 => 2,
+            5..=16 => 4,
+            _ => 8,
+        }
+    }
+
+    fn new(len: usize, palette_len: usize) -> Self {
+        let bits = Self::width(palette_len);
+        Self {
+            bytes: vec![0; len.div_ceil(8 / bits as usize)].into_boxed_slice(),
+            len,
+            bits,
+        }
+    }
+
+    fn from_slice(indices: &[u8], palette_len: usize) -> Self {
+        let mut packed = Self::new(indices.len(), palette_len);
+        for (i, &index) in indices.iter().enumerate() {
+            packed.set(i, index);
+        }
+        packed
+    }
+
+    #[inline]
+    fn get(&self, index: usize) -> u8 {
+        let bit = index * self.bits as usize;
+        (self.bytes[bit >> 3] >> (bit & 7)) & (u8::MAX >> (8 - self.bits))
+    }
+
+    #[inline]
+    fn set(&mut self, index: usize, value: u8) {
+        if value > (u8::MAX >> (8 - self.bits)) {
+            let mut wider = Self::new(self.len, value as usize + 1);
+            for i in 0..self.len {
+                wider.set(i, self.get(i));
+            }
+            *self = wider;
+        }
+        let bit = index * self.bits as usize;
+        let shift = bit & 7;
+        let mask = (u8::MAX >> (8 - self.bits)) << shift;
+        let byte = &mut self.bytes[bit >> 3];
+        *byte = (*byte & !mask) | (value << shift);
+    }
 }

