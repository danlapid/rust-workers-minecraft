+    #[test]
+    fn idle_heaps_grow_without_changing_pathfinding_order() {
+        let mut heap = BinaryHeap::new();
+        assert!(heap.heap.capacity() < 1024);
+        assert!(heap.is_empty());
+        for x in (0..1500).rev() {
+            let mut node = Node::new(BlockPos::new(x, 0, 0));
+            node.f = x as f32;
+            heap.insert(node);
+        }
+        for x in 0..1500 {
+            assert_eq!(heap.pop().unwrap().pos, BlockPos::new(x, 0, 0));
+        }
+        assert!(heap.pop().is_none());
+        heap.clear();
+        assert!(heap.get_heap().is_empty());
+        let mut node = Node::new(BlockPos::new(42, 0, 0));
+        node.f = 1.0;
+        heap.insert(node);
+        assert_eq!(heap.drain().len(), 1);
+        assert!(heap.is_empty());
+    }
