+                io_write,
+                send_chunk,
+                listener: Arc::new(ChunkListener::new()),
+                lighting_config: LightingEngineConfig::Default,
+                last_unload: std::time::Instant::now(),
+            },
+            receiver,
+        )
+    }
+
+    #[tokio::test]
+    async fn full_save_queue_retains_the_batch_until_capacity_is_available() {
+        let (mut scheduler, mut receiver) = scheduler();
+        let pos = ChunkPos::new(0, 0);
+        scheduler.chunk_map.insert(
+            pos,
+            ChunkHolder {
+                chunk: Some(chunk(StagedChunkEnum::Noise)),
+                ..Default::default()
+            },
+        );
+        scheduler.io_write.send(Vec::new()).await.unwrap();
+        let lock = scheduler.io_lock.clone();
+        let save = scheduler.save_all_chunk(true);
+        tokio::pin!(save);
+        assert!(
