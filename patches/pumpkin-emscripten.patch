+                .await
+                .is_err()
+        );
+        assert!(lock.0.lock().unwrap().is_empty());
+        receiver.recv().await.unwrap();
+        save.await;
+        let batch = receiver.recv().await.unwrap();
+        assert_eq!(batch.len(), 1);
