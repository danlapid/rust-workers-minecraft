+        scheduler.chunk_map.insert(
+            pos,
+            ChunkHolder {
+                occupied,
+                ..Default::default()
+            },
+        );
+        scheduler.running_task_count = 1;
+        let send = scheduler.send_chunk.clone();
+        let producer = tokio::spawn(async move {
+            tokio::time::sleep(Duration::from_millis(100)).await;
+            assert!(
+                send.send((pos, RecvChunk::IO(chunk(StagedChunkEnum::Empty))))
+                    .is_ok()
+            );
+        });
+        scheduler.drain_results().await;
+        assert_eq!(scheduler.running_task_count, 0);
+        assert!(scheduler.chunk_map[&pos].chunk.is_some());
+        producer.await.unwrap();
+    }
