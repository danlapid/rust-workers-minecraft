 }
+
+/// Spawn a fire-and-forget CPU task.
+///
+/// On normal targets this hands the closure to rayon's global thread pool. On
+/// `wasm32-unknown-emscripten` there are no OS threads and rayon has no worker to
+/// run an injected job (a bare `rayon::spawn` would never execute, so any code that
+/// then `.await`s the result over a channel would deadlock). There we run the
+/// closure inline on the calling thread instead.
+pub fn rayon_spawn<F: FnOnce() + Send + 'static>(f: F) {
+    #[cfg(feature = "single-threaded")]
+    {
+        f();
+    }
+    #[cfg(not(feature = "single-threaded"))]
+    {
+        rayon::spawn(f);
+    }
+}
+
+/// Schedule bounded synchronous work using the selected execution model.
+///
+/// Single-threaded builds run the closure in a regular Tokio task, preserving
+/// panic reporting through `JoinError` without creating a blocking-pool thread.
+/// The closure itself must finish without waiting for another task on this thread.
+/// JSPI does not make the public Tokio `spawn_blocking` API threadless.
+pub fn spawn_blocking<F, R>(f: F) -> tokio::task::JoinHandle<R>
+where
+    F: FnOnce() -> R + Send + 'static,
+    R: Send + 'static,
+{
+    #[cfg(feature = "single-threaded")]
+    {
+        tokio::spawn(async move { f() })
+    }
+    #[cfg(not(feature = "single-threaded"))]
+    {
+        tokio::task::spawn_blocking(f)
+    }
+}
