{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rust-workers-minecraft",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat", "new_module_registry", "no_handle_cross_request_promise_resolution"],
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "connect": [{ "protocol": "tcp", "address": "127.0.0.1", "port": 25565 }],
  "durable_objects": { "bindings": [{ "name": "WORLD", "class_name": "MinecraftWorld" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MinecraftWorld"] }],
  "vars": { "WORLD_NAME": "world" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
