{
  "name": "rust-workers-minecraft",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "durable-object-fs": "1.0.0",
    "worker-fs-mount": "0.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260905.1",
    "@types/node": "26.4.1",
    "typescript": "~5.9.3",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "durable-object-fs": {
      "worker-fs-mount": "$worker-fs-mount"
    }
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "dev": "bash scripts/serve.sh",
    "test": "bash scripts/test.sh",
    "test:memory": "npm run build && node tests/memory.mjs",
    "types": "wrangler types worker/env.d.ts --strict-vars=false",
    "typecheck": "npm run types && tsc --noEmit",
    "test:scheduler": "bash scripts/test-scheduler.sh",
    "test:experience": "npm run build && node tests/experience.mjs"
  }
}
